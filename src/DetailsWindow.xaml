<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="610" Height="350" MinWidth="520" MinHeight="300" WindowStartupLocation="CenterOwner">
  <Window.Resources><!--ThemeResources--></Window.Resources>
  <Border Background="#EF151D31" CornerRadius="24" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1">
    <Grid Margin="28,18,28,25">
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
      <Grid x:Name="TitleBar">
        <TextBlock x:Name="Heading" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button x:Name="CloseWindow" Style="{StaticResource WindowButton}" Content="&#xE8BB;" HorizontalAlignment="Right" AutomationProperties.Name="Закрыть"/>
      </Grid>
      <TextBox x:Name="Details" Grid.Row="1" Background="Transparent" Foreground="{StaticResource SecondaryText}" BorderThickness="0"
               IsReadOnly="True" TextWrapping="Wrap" FontSize="14" VerticalScrollBarVisibility="Auto" Margin="0,20,0,20"/>
      <Button x:Name="Done" Grid.Row="2" Content="Понятно" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="24,10"/>
    </Grid>
  </Border>
</Window>
