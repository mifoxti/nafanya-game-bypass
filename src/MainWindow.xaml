<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Игры и Nafanya" Width="1060" Height="740" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <Window.Resources><!--ThemeResources--></Window.Resources>
  <Border CornerRadius="24" BorderThickness="1" BorderBrush="#486D7A9D" ClipToBounds="True">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E811192D"/>
        <GradientStop Color="#EA121728" Offset="0.55"/>
        <GradientStop Color="#F01A1730" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid ClipToBounds="True">
      <Canvas IsHitTestVisible="False" ClipToBounds="True">
        <Ellipse Width="820" Height="640" Canvas.Left="-260" Canvas.Top="-360">
          <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#674B77B8"/><GradientStop Color="#004B77B8" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="790" Height="730" Canvas.Left="640" Canvas.Top="200">
          <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#4E7557A9"/><GradientStop Color="#007557A9" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>
      </Canvas>
      <Grid Margin="30,16,30,22">
        <Grid.RowDefinitions>
          <RowDefinition Height="48"/>
          <RowDefinition Height="148"/>
          <RowDefinition Height="66"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="104"/>
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="29" Height="29" CornerRadius="9" Background="#2BABC7FF" BorderBrush="#7BBCD2FF" BorderThickness="1">
              <TextBlock Text="N" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Nafanya" FontSize="17" FontWeight="SemiBold" Margin="11,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="/" Foreground="#637191" Margin="16,0" VerticalAlignment="Center"/>
            <TextBlock Text="Игры" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-16,0">
            <Button x:Name="Minimize" Style="{StaticResource WindowButton}" Content="&#xE921;" AutomationProperties.Name="Свернуть"/>
            <Button x:Name="Maximize" Style="{StaticResource WindowButton}" Content="&#xE922;" AutomationProperties.Name="Развернуть"/>
            <Button x:Name="CloseWindow" Style="{StaticResource WindowButton}" Content="&#xE8BB;" AutomationProperties.Name="Закрыть"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,24,0,4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="246"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="СВОЙ МАРШРУТ" FontSize="10" FontWeight="SemiBold" Foreground="#9BADCE" Margin="1,0,0,8"/>
            <TextBlock Text="Играй напрямую." FontSize="34" FontWeight="SemiBold" Margin="-1,0,0,7"/>
            <TextBlock Text="Выбирай игры, которые подключаются в обход Nafanya."
                       Foreground="{StaticResource SecondaryText}" FontSize="13" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource GlassPanel}" Padding="21,17" Margin="0,2,0,2">
            <Grid>
              <StackPanel>
                <TextBlock Text="ВЫБРАНО ДЛЯ ОБХОДА" FontSize="9" FontWeight="SemiBold" Foreground="#B4BED7"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock x:Name="BypassCount" Text="0" FontSize="31" FontWeight="SemiBold"/>
                  <TextBlock x:Name="BypassSuffix" Text="игр" Margin="9,0,0,6" VerticalAlignment="Bottom" Foreground="{StaticResource SecondaryText}"/>
                </StackPanel>
                <TextBlock x:Name="CountCaption" Text="Выбор для новых соединений" Foreground="{StaticResource FaintText}" FontSize="11" Margin="0,3,0,0"/>
              </StackPanel>
              <TextBlock Text="&#xE8AB;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="#91C0D8FF"
                         HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,15,0,12">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Мои игры" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock x:Name="GameCount" Foreground="{StaticResource FaintText}" Margin="10,3,0,0" FontSize="12"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RefreshGames" Style="{StaticResource QuietButton}" ToolTip="Обновить список" Margin="0,0,10,0" AutomationProperties.Name="Обновить список">
              <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{StaticResource SecondaryText}"/>
            </Button>
            <Button x:Name="AddFile" Style="{StaticResource GlassButton}" Content="Выбрать .exe" Margin="0,0,10,0"/>
            <Button x:Name="AddProcess" Style="{StaticResource GlassButton}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,1,8,0"/>
                <TextBlock Text="Из процессов"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="3">
          <ListBox x:Name="Games" Style="{StaticResource GlassList}" AutomationProperties.Name="Игры для прямого подключения">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource GlassPanel}" CornerRadius="19" Padding="17,15">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/>
                      <ColumnDefinition Width="56"/><ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="43" Height="43" CornerRadius="13" HorizontalAlignment="Left" Background="{Binding TileBrush}"
                            BorderBrush="#30FFFFFF" BorderThickness="1">
                      <Grid>
                        <TextBlock Text="{Binding Initial}" Foreground="{StaticResource Text}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding InitialVisibility}"/>
                        <Image Source="{Binding Icon}" Width="30" Height="30" Stretch="Uniform"/>
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                      <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{StaticResource FaintText}" Margin="0,5,0,0"
                                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding ModeLabel}" Foreground="{Binding ModeBrush}" FontSize="12" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,16,0"/>
                    <CheckBox Grid.Column="3" Style="{StaticResource GlassSwitch}" IsChecked="{Binding Enabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                              VerticalAlignment="Center" HorizontalAlignment="Left" AutomationProperties.Name="{Binding ToggleLabel}"/>
                    <Button Grid.Column="4" Style="{StaticResource QuietButton}" Tag="{Binding}" ToolTip="Убрать из списка" AutomationProperties.Name="Убрать игру из списка"
                            VerticalAlignment="Center" Padding="6" Margin="8,0,-6,0">
                      <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" Foreground="#8692AF" FontSize="10"/>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EmptyState" Text="Добавь игру из процессов или выбери её .exe" Foreground="{StaticResource SecondaryText}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,8,0,0">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="25"/></Grid.RowDefinitions>
          <Border BorderThickness="0,1,0,0" BorderBrush="#1FABB9DE" Padding="0,15,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#91D6BF" Margin="0,0,8,0"/>
                  <TextBlock x:Name="StatusTitle" Text="Список игр" FontSize="12"/>
                </StackPanel>
                <TextBlock x:Name="StatusDetail" Text="Загрузка настроек…" FontSize="11" Foreground="{StaticResource FaintText}" Margin="14,5,0,0"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="Inspect" Style="{StaticResource QuietButton}" Content="Соединения" Margin="0,0,10,0"/>
                <Button x:Name="Undo" Style="{StaticResource GlassButton}" Content="Откат" Margin="0,0,10,0"/>
                <Button x:Name="Apply" Style="{StaticResource PrimaryButton}" Content="Применить" Padding="24,11"/>
              </StackPanel>
            </Grid>
          </Border>
          <TextBlock Grid.Row="1" Text="В Nafanya должна быть включена категория «Российские сайты»."
                     FontSize="10" Foreground="#7F8BA7" VerticalAlignment="Bottom"/>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
