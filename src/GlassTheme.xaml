<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Text" Color="#F3F4FC"/>
  <SolidColorBrush x:Key="SecondaryText" Color="#A4AFC9"/>
  <SolidColorBrush x:Key="FaintText" Color="#7E8BA8"/>
  <SolidColorBrush x:Key="Accent" Color="#CAD9FF"/>
  <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#243C4C73" Offset="0"/>
    <GradientStop Color="#122A304B" Offset="0.55"/>
    <GradientStop Color="#202B304E" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0.8,1">
    <GradientStop Color="#52D9E3FF"/>
    <GradientStop Color="#12B3C7FF" Offset="0.45"/>
    <GradientStop Color="#26C2BAF3" Offset="1"/>
  </LinearGradientBrush>
  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="WindowStyle" Value="None"/>
    <Setter Property="ResizeMode" Value="CanResize"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
  </Style>
  <Style x:Key="GlassPanel" TargetType="Border">
    <Setter Property="CornerRadius" Value="22"/>
    <Setter Property="Background" Value="{StaticResource GlassFill}"/>
    <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style x:Key="GlassButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Padding" Value="16,11"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
    <Setter Property="Background" Value="#173D4B70"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" CornerRadius="13" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="#354B5F89"/>
              <Setter TargetName="Surface" Property="BorderBrush" Value="#79D7E4FF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Opacity" Value="0.7"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush" Value="#E6D7E4FF"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Opacity" Value="0.38"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
    <Setter Property="Foreground" Value="#141D35"/>
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#E4EBFF"/>
          <GradientStop Color="#B7CAFF" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderBrush" Value="#E5FFFFFF"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" CornerRadius="13" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <Border.Effect><DropShadowEffect Color="#6F8CCF" BlurRadius="22" ShadowDepth="0" Opacity="0.22"/></Border.Effect>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F1F4FF"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#749DFF"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
    <Setter Property="Padding" Value="10,9"/>
  </Style>
  <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Width" Value="38"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style x:Key="GlassSwitch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Width" Value="48"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid>
            <Border x:Name="Track" CornerRadius="14" Background="#343C4C68" BorderBrush="#416E7B98" BorderThickness="1"/>
            <Border x:Name="Knob" Width="20" Height="20" CornerRadius="10"
                    Background="#D9E2F6" HorizontalAlignment="Left" Margin="4,0,0,0">
              <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
              <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.2"/></Border.Effect>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="#668BAFF7"/>
              <Setter TargetName="Track" Property="BorderBrush" Value="#B4C4DDFF"/>
              <Setter TargetName="Knob" Property="Background" Value="#FFFFFFFF"/>
              <Setter TargetName="Knob" Property="RenderTransform">
                <Setter.Value><TranslateTransform X="20"/></Setter.Value>
              </Setter>
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                   To="20" Duration="0:0:0.16" DecelerationRatio="0.8"/>
                </Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                   To="0" Duration="0:0:0.16" DecelerationRatio="0.8"/>
                </Storyboard></BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#E4E8F4FF"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#FFFFFFFF"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="GlassInput" TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
    <Setter Property="SelectionBrush" Value="#6F8FCA"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="15,12"/>
    <Setter Property="Background" Value="#2D080E20"/>
    <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Surface" CornerRadius="13" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A3AFCBFF"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="GlassList" TargetType="ListBox">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <Setter Property="Foreground" Value="{StaticResource Text}"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0,0,0,12"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Focus" CornerRadius="19" BorderThickness="1" BorderBrush="Transparent">
                  <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="#A3AFCBFF"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ProcessRow" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="Margin" Value="0,0,0,5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Surface" Background="#103F4C71" BorderBrush="Transparent" BorderThickness="1"
                  CornerRadius="13" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#253F4C71"/></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="#3B6F8DC6"/>
              <Setter TargetName="Surface" Property="BorderBrush" Value="#8CBACDFF"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A3AFCBFF"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="7"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0">
                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb MinHeight="24">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbFill" CornerRadius="3" Background="#42537095" Margin="1,0"/>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbFill" Property="Background" Value="#718DA9D8"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0">
                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
